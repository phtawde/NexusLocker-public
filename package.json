{
  "scripts": {
    "dev": "concurrently -k -n FLASK, VITE -c blue.green \"npm:dev:flask\" \"npm:dev:react\"",
    "dev:flask": "python -m flask --app backend.app run --debug --port 5000",
    "dev:react": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
